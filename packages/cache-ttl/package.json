{
  "name": "@dalisoft/cache-ttl",
  "version": "0.4.4",
  "description": "Caching Library with TTL for Node.js and browser",
  "types": "dist/es/cache.d.ts",
  "module": "dist/es/cache-ttl.js",
  "main": "dist/cjs/cache-ttl.js",
  "cdn": "dist/umd/cache-ttl.min.js",
  "browser": "dist/umd/cache-ttl.min.js",
  "scripts": {
    "dev": "bun ../../build.js ./src/cache.ts --name=CacheTTL --clean=dist --es=./dist/es/cache-ttl.js --cjs=./dist/cjs/cache-ttl.js --umd=./dist/umd/cache-ttl.js --watch=./src",
    "build": "bun ../../build.js ./src/cache.ts --name=CacheTTL --clean=dist --es=./dist/es/cache-ttl.js --cjs=./dist/cjs/cache-ttl.js --umd=./dist/umd/cache-ttl.js --min=./dist/umd/cache-ttl.min.js && tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --test --test-timeout=10000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dalisoft/cache-ttl.git"
  },
  "bugs": {
    "url": "https://github.com/dalisoft/cache-ttl/issues"
  },
  "homepage": "https://github.com/dalisoft/cache-ttl#readme",
  "keywords": [
    "ttl",
    "cache",
    "promise",
    "async",
    "await",
    "fast",
    "in-memory"
  ],
  "author": "dalisoft",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}
