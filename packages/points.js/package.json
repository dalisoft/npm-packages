{
  "name": "points.js",
  "version": "1.1.6",
  "description": "Fast & Lightweight SVG Shape Manipulation library based on Points",
  "main": "points.js",
  "cdn": "points.min.js",
  "module": "index.js",
  "scripts": {
    "fix": "biome check --write .",
    "lint": "biome lint .",
    "test": "npm run fix && npm run lint",
    "minify": "bun ../../build.js index.js --name=PointsJS --named --bundle --min=points.min.js",
    "source": "bun ../../build.js index.js --name=PointsJS --named --bundle --sourcemap --umd=points.js",
    "prepublishOnly": "npm test && npm run source && npm run minify",
    "dev": "bun ../../build.js index.js --name=PointsJS --named --bundle --sourcemap --umd=points.js --watch=./src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dalisoft/points.js.git"
  },
  "keywords": [
    "shape",
    "svg",
    "points",
    "manipulation",
    "morph",
    "curve",
    "bezier",
    "normalise",
    "normalize",
    "optimize",
    "moveto",
    "lineto",
    "quadratic",
    "polygon"
  ],
  "author": "dalisoft",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dalisoft/points.js/issues"
  },
  "homepage": "https://github.com/dalisoft/points.js#readme",
  "dependencies": {
    "approximate-curve": "^0.0.1",
    "svg-points": "^6.0.1"
  }
}
