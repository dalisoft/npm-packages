{
  "name": "@dalisoft/as-batch",
  "version": "0.1.8",
  "description": "Convert many calls into batches",
  "keywords": [
    "call",
    "batch"
  ],
  "homepage": "https://github.com/dalisoft/as-batch#readme",
  "bugs": {
    "url": "https://github.com/dalisoft/as-batch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dalisoft/as-batch.git"
  },
  "license": "MIT",
  "author": "dalisoft",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/es/as-batch.d.ts",
      "default": "./dist/es/as-batch.js"
    }
  },
  "main": "dist/es/as-batch.js",
  "types": "dist/es/as-batch.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/as-batch.ts --target=node --packages=external --outfile=./dist/es/as-batch.js",
    "postbuild": "tsrs --emitDeclarationOnly",
    "prepublishOnly": "bun run test",
    "pretest": "bun run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
