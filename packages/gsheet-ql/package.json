{
  "name": "gsheet-ql",
  "version": "0.1.1",
  "description": "An Google Sheet Query language ORM",
  "keywords": [
    "google",
    "sheets",
    "orm",
    "promise",
    "es6",
    "typescript"
  ],
  "homepage": "https://github.com/dalisoft/gsheet-ql#readme",
  "bugs": {
    "url": "https://github.com/dalisoft/gsheet-ql/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dalisoft/gsheet-ql.git"
  },
  "license": "MIT",
  "author": "dalisoft",
  "type": "module",
  "exports": {
    ".": "./dist/es/gsheet-ql.js"
  },
  "main": "dist/es/gsheet-ql.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/_class.ts --target=node --packages=external --outfile=./dist/es/gsheet-ql.js",
    "dev": "bun build ./src/_class.ts --target=node --packages=external --watch --outfile=./dist/es/gsheet-ql.js",
    "prepublishOnly": "bun run build"
  }
}
